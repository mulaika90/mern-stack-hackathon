MONGODB_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
IMAGEKIT_PRIVATE_KEY=your-imagekit-private-key

# Configure all three to create the first clinic administrator on startup.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
